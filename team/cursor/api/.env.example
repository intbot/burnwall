# Cursor Admin API key with admin:* scope (cursor.com/dashboard -> API Keys). Never commit the real one.
CURSOR_ADMIN_API_KEY=crsr_...

# dev   = no sign-in; every request is DEV_USER_EMAIL (only accepted from localhost)
# oidc  = Bearer token from any OpenID Connect provider (Okta, Auth0, Google, Keycloak, Entra, ...)
# entra = oidc with Entra's details filled in from ENTRA_TENANT_ID
AUTH_MODE=dev
DEV_USER_EMAIL=you@example.com

# Comma-separated; these people can see everyone's usage and trigger a sync
ADMIN_EMAILS=you@example.com

# Your organization's name as people know it, used in text like "New at ACME" and "from ACME's usage".
# Default: "your organization".
ORG_NAME=

# Monthly limit to assume for someone Cursor reports no per-person limit for
DEFAULT_LIMIT_DOLLARS=200

# auto = follow Cursor's billing cycle start (from /teams/spend); calendar = UTC calendar months
BILLING_CYCLE=auto

# Coaching, model-update, pace and alert thresholds can be overridden one by one, e.g. COACH_LONG_CHAT_PROMPTS=25
# or PACE_WATCH_SHARE=0.75. Names and defaults are in app/rules.py. On a team of fewer than ~100 active people,
# lower the team-wide counts roughly in proportion:
# COACH_CURRENT_MODEL_MIN_PROMPTS=200
# NEWS_NEW_MODEL_MIN_PROMPTS=200
# NEWS_FREE_MIN_PROMPTS=50

# Address for run-local.cmd / run-local.sh
# HOST=127.0.0.1
# PORT=8787

# When set, only these email domains get in (oidc and entra). Comma-separated.
ALLOWED_EMAIL_DOMAINS=

# OIDC (AUTH_MODE=oidc only). Keys come from <issuer>/.well-known/openid-configuration.
OIDC_ISSUER=
# Comma-separated accepted audiences (the token's aud)
OIDC_AUDIENCES=
# Optional: a scope the token must carry
OIDC_REQUIRED_SCOPE=
# Claims to read the email from, first one present wins (default: email; Entra: preferred_username,upn,email)
OIDC_EMAIL_CLAIM=

# Entra (AUTH_MODE=entra only)
ENTRA_TENANT_ID=
# Comma-separated accepted audiences, e.g. api://<api-client-id>,<api-client-id>
ENTRA_AUDIENCES=
ENTRA_REQUIRED_SCOPE=access_as_user

# Testing aids for admins (user picker in the extension). Leave false in production.
DEV_TOOLS=false

# Sync
SYNC_ENABLED=true
SYNC_MINUTES=15
# First day to load on an empty database (default: 1st of previous month)
BACKFILL_START=
DB_PATH=data/usage.db
